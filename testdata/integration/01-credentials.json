{
  "name": "managed credentials",
  "description": "Create, use, and revoke managed API keys and WebDAV credentials.",
  "steps": [
    {
      "type": "http",
      "name": "create api key",
      "method": "POST",
      "path": "/api/v1/admin/api-keys",
      "auth": "session",
      "body": { "name": "it-${run_id}" },
      "save": { "api_key": "token", "key_id": "id" },
      "expect": { "status": 201, "json": [{ "path": "id", "exists": true }] }
    },
    {
      "type": "http",
      "name": "use managed api key",
      "method": "GET",
      "path": "/api/v1/stats",
      "bearer": "${api_key}",
      "expect": { "status": 200, "json": [{ "path": "messages", "gte": 0 }] }
    },
    {
      "type": "http",
      "name": "managed key cannot manage credentials",
      "method": "GET",
      "path": "/api/v1/admin/api-keys",
      "bearer": "${api_key}",
      "expect": { "status": 403 }
    },
    {
      "type": "http",
      "name": "create webdav user",
      "method": "POST",
      "path": "/api/v1/admin/webdav-users",
      "auth": "session",
      "body": { "username": "dav-${run_id}" },
      "save": { "dav_user": "username", "dav_pass": "password" },
      "expect": { "status": 201, "json": [{ "path": "generated", "equals": true }] }
    },
    {
      "type": "webdav",
      "name": "webdav accepts managed user",
      "method": "PROPFIND",
      "path": "/dav/",
      "basic": { "username": "${dav_user}", "password": "${dav_pass}" },
      "depth": "1",
      "body_raw": "<?xml version=\"1.0\"?><propfind xmlns=\"DAV:\"><allprop/></propfind>",
      "expect": { "status": 207 }
    },
    {
      "type": "http",
      "name": "delete api key",
      "method": "DELETE",
      "path": "/api/v1/admin/api-keys/${key_id}",
      "auth": "session",
      "expect": { "status": 200 }
    },
    {
      "type": "http",
      "name": "revoked api key is rejected",
      "method": "GET",
      "path": "/api/v1/stats",
      "bearer": "${api_key}",
      "expect": { "status": 401 }
    },
    {
      "type": "http",
      "name": "delete webdav user",
      "method": "DELETE",
      "path": "/api/v1/admin/webdav-users/${dav_user}",
      "auth": "session",
      "expect": { "status": 200 }
    },
    {
      "type": "webdav",
      "name": "revoked webdav user is rejected",
      "method": "PROPFIND",
      "path": "/dav/",
      "basic": { "username": "${dav_user}", "password": "${dav_pass}" },
      "depth": "1",
      "body_raw": "<?xml version=\"1.0\"?><propfind xmlns=\"DAV:\"><allprop/></propfind>",
      "expect": { "status": 404 }
    }
  ]
}
